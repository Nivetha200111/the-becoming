# Configure these as encrypted Vercel runtime environment variables.
# Never commit actual values.
# Prefer the salted hash from npm run access:hash; the actual passphrase never leaves your terminal.
APP_PASSWORD_HASH=
# Legacy deployments may keep this instead; do not set both.
APP_PASSWORD=
SESSION_SECRET=
# Optional private office pin, served only after signing in. JSON with latitude, longitude and name.
OFFICE_LOCATION=
# Supported service credential for the existing owner-private save backend.
SITES_SAVE_TOKEN=
# The save is kept in your own Notion workspace whenever Notion is connected (see docs/DEPLOYMENT.md): it uses
# NOTION_TOKEN and the Party HQ database, or NOTION_SAVE_DATABASE_ID if you give the save a database of its own.
# Set SAVE_STORE=site to force the old backend instead. If SITES_SAVE_TOKEN is set, the existing save is copied across once.
SAVE_STORE=
NOTION_SAVE_DATABASE_ID=
NOTION_SAVE_DATA_SOURCE_ID=
# Optional one-way Notion quest log (see docs/DEPLOYMENT.md). Server-side only.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Only needed if that database has more than one data source.
NOTION_DATA_SOURCE_ID=
# Optional Party HQ database the Grok bots write into (see docs/GROK_BOTS.md). Uses NOTION_TOKEN.
NOTION_PARTY_DATABASE_ID=
NOTION_PARTY_DATA_SOURCE_ID=
# Achievements with XP in the ACHIEVEMENTS database on NIVETHA LIFE OS are counted into the game automatically.
# Set ACHIEVEMENTS_SYNC=off to stop that, or point it at another database. Uses NOTION_TOKEN.
ACHIEVEMENTS_SYNC=
NOTION_ACHIEVEMENTS_DATABASE_ID=
NOTION_ACHIEVEMENTS_DATA_SOURCE_ID=
# Optional Grok Bot routine webhook pinged after each chat Message row is created. Server-side only; never prefix with NEXT_PUBLIC_.
GROK_WEBHOOK_URL=https://example.invalid/your-grok-routine-webhook
# Full Authorization header value as copied from the Grok app (may include "Bearer ").
GROK_WEBHOOK_AUTH=Bearer replace-me
