# Configure these as encrypted Vercel runtime environment variables.
# Never commit actual values.
# Prefer the salted hash from npm run access:hash; the actual passphrase never leaves your terminal.
APP_PASSWORD_HASH=
# Legacy deployments may keep this instead; do not set both.
APP_PASSWORD=
SESSION_SECRET=
# Supported service credential for the existing owner-private save backend.
SITES_SAVE_TOKEN=
# Optional one-way Notion quest log (see docs/DEPLOYMENT.md). Server-side only.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Only needed if that database has more than one data source.
NOTION_DATA_SOURCE_ID=
# Optional Party HQ database the Grok bots write into (see docs/GROK_BOTS.md). Uses NOTION_TOKEN.
NOTION_PARTY_DATABASE_ID=
NOTION_PARTY_DATA_SOURCE_ID=
